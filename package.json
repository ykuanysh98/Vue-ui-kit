{
  "name": "ku-ui-kit",
  "version": "1.0.9",
  "description": "A Vue 3 UI component library for building modern web applications.",
  "main": "./dist/vue-ui-kit.umd.js",
  "module": "./dist/vue-ui-kit.es.js",
  "exports": {
    ".": {
      "import": "./dist/vue-ui-kit.es.js",
      "require": "./dist/vue-ui-kit.umd.js"
    },
    "./style.css": "./dist/assets/styles/tokens.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "npm:login": "npm whoami || npm login",
    "npm:publish": "npm publish --access public"
  },
  "dependencies": {
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-docs": "^10.4.1",
    "@storybook/addon-vitest": "^10.4.1",
    "@storybook/vue3-vite": "^10.4.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "playwright": "^1.60.0",
    "storybook": "^10.4.1",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  }
}
